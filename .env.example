# Copie ce fichier en .env et remplis-le. Ne le pousse jamais sur GitHub.

# --- Google Ads API ---
GOOGLE_ADS_API_TOKEN=        # developer token (Centre API du MCC)
MCC_ID=                      # identifiant du MCC, sans tirets

# --- OAuth (client de type "Application Web" dans Google Cloud) ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080

# --- Gemini ---
GOOGLE_API_KEY=              # clé API Gemini (AI Studio)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Facultatif ---
# GOOGLE_ADS_REFRESH_TOKEN=  # local uniquement : évite de se reconnecter à chaque lancement
# DEFAULT_BUCKET_NAME=       # bucket GCS pour la mémoire par client (sinon dossier data/clients)
# BATCH_SIZE=15              # taille des lots d'entraînement
# DEMO_MODE=1                # compte fictif + IA simulée, sans aucune clé
